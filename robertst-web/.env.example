# Copy to `.env` and fill in. Never commit real values.

# ── Database ────────────────────────────────────────────────────────────────
# Any Postgres 14+. `npm run db:up` starts the one in docker-compose.yml.
DATABASE_URL="postgresql://amphora:amphora@localhost:5433/amphora?schema=public"

# Only needed when DATABASE_URL points at a connection pooler (Neon, Supabase,
# Prisma Accelerate). Migrations cannot run through PgBouncer in transaction
# mode, so the CLI uses this unpooled endpoint instead. Leave unset locally.
# DIRECT_DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"

# ── Authentication ──────────────────────────────────────────────────────────
# HMAC key for CMS session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it signs every existing session out. Required in production.
AUTH_SECRET=""

# Consumed by `npm run cms:user` only, so the first admin can be created
# without an interactive prompt in CI or on a fresh deploy.
# ADMIN_EMAIL="you@example.com"
# ADMIN_PASSWORD=""

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, Open Graph tags and share links.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Media storage (optional) ────────────────────────────────────────────────
# Without a token, uploads are rejected and the CMS accepts external image URLs
# instead — everything else works. Create a Vercel Blob store and paste its
# read/write token to enable uploading.
# BLOB_READ_WRITE_TOKEN=""

# ── Newsletter (optional) ───────────────────────────────────────────────────
# /api/newsletter-preview returns the weekly issue as JSON. It is disabled in
# production unless this is "1", because it lists every story in the collection.
# NEWSLETTER_PREVIEW=""

# ── Provided by the platform ────────────────────────────────────────────────
# Do not set these. Vercel injects VERCEL_PROJECT_PRODUCTION_URL, and lib/site.ts
# falls back to it when NEXT_PUBLIC_SITE_URL is unset, so canonical URLs and
# Open Graph tags are correct on a fresh deploy with no configuration.

# ── Tests (optional) ────────────────────────────────────────────────────────
# Integration tests run against this database and truncate it between runs, so
# it must NOT be your development database. Tests skip when it is unset.
# TEST_DATABASE_URL="postgresql://amphora:amphora@localhost:5433/amphora_test?schema=public"
